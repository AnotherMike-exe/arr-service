# Copy to .env and fill in. Find each API key in the app under:
#   Settings -> General -> Security -> API Key
#
# Any number of instances are supported. Each one needs a matching
# <NAME>_URL and <NAME>_API_KEY pair. The prefix before the first
# underscore determines the app type (SONARR* -> sonarr, RADARR* -> radarr).

SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=

RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=

# Optional additional instances, e.g. a 4K pair:
# SONARR_4K_URL=http://192.168.1.10:8990
# SONARR_4K_API_KEY=
# RADARR_4K_URL=http://192.168.1.10:7879
# RADARR_4K_API_KEY=
